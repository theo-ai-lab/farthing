# Farthing environment — copy to .env and fill in. NEVER commit .env.
#
# The two Stripe keys are DIFFERENT restricted keys and belong to DIFFERENT
# processes. If the agent worker can see the execute key, startup fails on purpose.

# --- Agent worker (PREPARE scope only) ---
FARTHING_STRIPE_PREPARE_KEY=rk_test_prepare_xxx      # Stripe restricted key: read + refund-prepare
FARTHING_ANTHROPIC_API_KEY=sk-ant-xxx
FARTHING_EXTRACTION_MODEL=anthropic:claude-sonnet-5
FARTHING_ESCALATION_MODEL=anthropic:claude-opus-4-8
FARTHING_TEMPORAL_ADDRESS=localhost:7233
FARTHING_TEMPORAL_NAMESPACE=default
FARTHING_TASK_QUEUE=farthing-agent
FARTHING_RECONCILE_DATABASE_URL=postgresql://reconcile_ro:pw@localhost:5432/temporal  # read-only ledger access for nightly reconciliation
# Do NOT set FARTHING_STRIPE_EXECUTE_KEY here — it must not be visible to the worker.

# --- Approval service (EXECUTE scope + signing secret) ---
# The APPROVAL_ prefix is the settings namespace; the doubled word in
# FARTHING_APPROVAL_APPROVAL_SIGNING_SECRET is intentional, not a typo.
FARTHING_APPROVAL_STRIPE_EXECUTE_KEY=rk_test_execute_xxx   # Stripe restricted key: refund-execute
FARTHING_APPROVAL_APPROVAL_SIGNING_SECRET=change-me-32-bytes-min
FARTHING_APPROVAL_DATABASE_URL=postgresql://temporal:temporal@localhost:5432/temporal   # durable idempotency store
FARTHING_APPROVAL_PROXY_SHARED_SECRET=change-me   # the auth proxy must send this as X-Proxy-Auth AND strip inbound X-Reviewer-Email
FARTHING_APPROVAL_TEMPORAL_ADDRESS=localhost:7233
FARTHING_APPROVAL_TEMPORAL_NAMESPACE=default
FARTHING_APPROVAL_EXECUTE_TASK_QUEUE=farthing-execute

# --- Observability ---
FARTHING_OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
# Langfuse OTLP needs an auth header (comma-separated key=value pairs):
FARTHING_OTLP_HEADERS=Authorization=Basic <base64(public_key:secret_key)>
